# Local ComfyUI + official Comfy API v2 proxy. Keep secrets out of VITE_* variables.
COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_API_KEY=
PORT=3001

# For Comfy Cloud: use https://cloud.comfy.org and your server-side Comfy API key.
# For a Comfy deployment: use https://YOUR-DEPLOYMENT.run.comfy.app and its API key.
# Only needed if you intentionally serve the studio from another trusted origin:
# TOYBOX_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001
