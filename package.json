{
  "name": "toybox-director",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdi-salmanzade/toybox-director.git"
  },
  "homepage": "https://github.com/mahdi-salmanzade/toybox-director#readme",
  "bugs": {
    "url": "https://github.com/mahdi-salmanzade/toybox-director/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n studio,api \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env server/index.mjs\"",
    "dev:ui": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:server": "node --test server/*.test.mjs",
    "test": "node --test tests/*.test.ts server/*.test.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "@comfyorg/sdk": "0.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
